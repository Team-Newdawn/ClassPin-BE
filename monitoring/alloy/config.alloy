discovery.docker "ohpin" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "ohpin_logs" {
  targets = discovery.docker.ohpin.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/ohpin-be"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "ohpin" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.relabel.ohpin_logs.output
  labels        = { job = "docker", service_name = "ohpin-be", environment = "production" }
  forward_to    = [loki.write.local.receiver]
}

local.file_match "nginx" {
  path_targets = [{
    __path__     = "/var/log/nginx/*.log",
    job          = "nginx",
    service_name = "nginx",
    environment  = "production",
  }]
}

loki.source.file "nginx" {
  targets    = local.file_match.nginx.targets
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
